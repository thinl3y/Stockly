# Stockly - Firebase configuration
# 1. Copy this file and name the copy ".env" (same folder as package.json).
# 2. Paste the values from Firebase console > Project settings > Your apps > Web app (</>).
# 3. Restart Expo with:  npx expo start --clear
# Never commit your real .env file. It is listed in .gitignore.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
